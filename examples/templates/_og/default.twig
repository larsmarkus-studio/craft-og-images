{# OG image template: rendered in a 1200x630 viewport by Gotenberg.
   Available: entry, site. Put fonts and images in _og/assets/ and reference them
   by filename; anything else must be an absolute URL on a host in Gotenberg's allow-list. #}
<!doctype html>
<html lang="{{ site.language }}">
<head>
  <meta charset="utf-8">
  <style>
    * { box-sizing: border-box; margin: 0; }
    html, body { width: 1200px; height: 630px; }
    body {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 72px 80px;
      background: #111;
      color: #fff;
      font-family: system-ui, sans-serif;
    }
    h1 { font-size: 72px; line-height: 1.05; letter-spacing: -0.02em; max-width: 1000px; }
    p { font-size: 28px; opacity: .7; }
  </style>
</head>
<body>
  <h1>{{ entry.title }}</h1>
  <p>{{ site.name }}</p>
</body>
</html>
